# Copy to .env.local to override. Every value has a local default (see src/lib/config.ts),
# so this file is optional when the API and Keycloak run from `pnpm dev:infra`.
# These values are sent to the browser: never put a secret here.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OIDC_AUTHORITY=http://localhost:8080/realms/atlas
NEXT_PUBLIC_OIDC_CLIENT_ID=atlas-web
