# Copy to .env for local overrides. Every setting has a safe local default in
# services/api/app/core/config.py, so this file is optional for `pnpm dev:infra` + `pnpm api:dev`.

ATLAS_ENV=local
ATLAS_LOG_LEVEL=INFO
ATLAS_LOG_JSON=false

# Runtime connection uses the non-owner role so row-level security applies.
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas_app:atlas_app@localhost:5432/atlas
# Migrations and seeding use the owner role.
ATLAS_MIGRATION_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
ATLAS_REDIS_URL=redis://localhost:6379/0

# OIDC (Keycloak in local dev)
ATLAS_OIDC_ISSUER=http://localhost:8080/realms/atlas
ATLAS_OIDC_AUDIENCE=atlas-api
# Optional: where the API fetches signing keys, if different from the issuer host.
# ATLAS_OIDC_JWKS_URL=http://keycloak:8080/realms/atlas/protocol/openid-connect/certs

ATLAS_CORS_ORIGINS=["http://localhost:3000"]

# ---- Documents and ingestion ----
# Where uploaded files are stored. The API and the worker must see the same directory.
# ATLAS_BLOB_DIR=./data/blobs
# ATLAS_MAX_UPLOAD_BYTES=26214400

# ---- Embeddings ----
# "hash" needs no key: a simple word-matching embedder for local development and tests.
# "voyage" is the real model (https://www.voyageai.com). Changing the provider or model
# means every document must be ingested again, because old and new vectors do not compare.
ATLAS_EMBEDDING_PROVIDER=hash
# ATLAS_EMBEDDING_MODEL=voyage-3.5
# ATLAS_VOYAGE_API_KEY=

# ---- Answers (Claude) ----
# Without a key, /v1/ask returns 503; upload and /v1/search still work.
# ATLAS_ANTHROPIC_API_KEY=
# ATLAS_CHAT_MODEL=claude-opus-5-5
# ATLAS_CHAT_EFFORT=medium
# ATLAS_RETRIEVAL_TOP_K=8
